@{
    ViewData["Title"] = "Alerts";
    Layout = "_DashboardLayout";
}

<link rel="stylesheet" href="~/css/alerts.css" />

<h1 class="page-title">🚨 Safety Alerts</h1>

<!-- FILTER BAR -->
<div class="alert-filters">
    <div class="filter">
        <label>Severity</label>
        <select>
            <option>All</option>
            <option>High</option>
            <option>Medium</option>
            <option>Low</option>    
        </select>
    </div>

    <div class="filter">
        <label>Alert Type</label>
        <select>
            <option>All</option>
            <option>PPE Violation</option>
            <option>Fatigue Detected</option>
            <option>Unsafe Behavior</option>
            <option>Accident Risk</option>
        </select>
    </div>

    <div class="filter">
        <label>Date</label>
        <input type="date" />
    </div>

    <button class="btn primary">Apply</button>
</div>

<!-- ALERT SUMMARY -->
<div class="alert-summary">
    <div class="summary-card high">
        <h3>High</h3>
        <p>6</p>
    </div>

    <div class="summary-card medium">
        <h3>Medium</h3>
        <p>10</p>
    </div>

    <div class="summary-card low">
        <h3>Low</h3>
        <p>14</p>
    </div>
</div>

<!-- ALERTS TABLE -->
<div class="table-card">
    <table>
        <thead>
            <tr>
                <th>Time</th>
                <th>Camera</th>
                <th>Alert Type</th>
                <th>Severity</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>10:42 AM</td>
                <td>Camera 3</td>
                <td>PPE Violation</td>
                <td class="high">High</td>
                <td><span class="status new">New</span></td>
            </tr>

            <tr>
                <td>11:10 AM</td>
                <td>Camera 1</td>
                <td>Fatigue Detected</td>
                <td class="medium">Medium</td>
                <td><span class="status resolved">Resolved</span></td>
            </tr>

            <tr>
                <td>12:05 PM</td>
                <td>Camera 2</td>
                <td>Unsafe Behavior</td>
                <td class="low">Low</td>
                <td><span class="status inprogress">In Progress</span></td>
            </tr>
        </tbody>
    </table>
</div>
