@model SiteSafe4.Models.ResetPasswordVM
@{
    ViewData["Title"] = "Reset Password";
    ViewData["HideNavbar"] = true; // hides navbar
}

<link rel="stylesheet" href="~/css/forgot-password.css" />

<div class="forgot-page">
    <div class="forgot-card">

        <!-- LEFT: Form -->
        <div class="forgot-left">
            <div class="brand">
                <img src="~/images/logo-sitesafe.jpeg" alt="SiteSafe Logo" />
            </div>

            <h2>Reset Your Password</h2>
            <p class="subtitle">
                Enter your new password below.
            </p>

            @* Show validation errors *@
            <div asp-validation-summary="ModelOnly" class="error"></div>

            <form asp-action="ResetPassword" method="post">
                @* Hidden fields to retain email and token *@
                <input type="hidden" asp-for="Email" />
                <input type="hidden" asp-for="Token" />

                <!-- New Password -->
                <label>New Password</label>
                <input asp-for="Password" type="password" class="input" placeholder="Enter new password" />
                <span asp-validation-for="Password" class="error"></span>

                <!-- Confirm Password -->
                <label>Confirm Password</label>
                <input asp-for="ConfirmPassword" type="password" class="input" placeholder="Confirm new password" />
                <span asp-validation-for="ConfirmPassword" class="error"></span>

                <button type="submit" class="btn">
                    Reset Password
                </button>
            </form>

            <div class="back-link">
                <a asp-controller="Account" asp-action="Login">← Back to Login</a>
            </div>
        </div>

        <!-- RIGHT: Illustration -->
        <div class="forgot-right">
            <img src="~/images/work_safe.jpeg" alt="Safety Illustration" />
            <h3>Secure Account Recovery</h3>
            <p>Your account password will be updated securely.</p>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
