@model SiteSafe4.Models.ForgotPasswordVM
@{
    ViewData["Title"] = "Forgot Password";
    ViewData["HideNavbar"] = true; // hide the navbar
}

<link rel="stylesheet" href="~/css/forgot-password.css" />

<div class="forgot-page">
    <div class="forgot-card">

        <!-- LEFT: Form -->
        <div class="forgot-left">
            <div class="brand">
                <img src="~/images/logo-sitesafe.jpeg" alt="SiteSafe Logo" />
            </div>

            <h2>Forgot Password?</h2>
            <p class="subtitle">
                Enter your registered email address.<br />
                We’ll send you a link to reset your password.
            </p>

            @* Show message after form submission *@
            @if (ViewBag.Message != null)
            {
                <div class="success-message">@ViewBag.Message</div>
            }

            <form asp-controller="Account" asp-action="ForgotPassword" method="post">
                <div asp-validation-summary="ModelOnly" class="error"></div>

                <!-- Email -->
                <label>Email Address</label>
                <input asp-for="Email" class="input" placeholder="Enter your email" />
                <span asp-validation-for="Email" class="error"></span>

                <button type="submit" class="btn">
                    Send Reset Link
                </button>
            </form>

            <div class="back-link">
                <a asp-controller="Account" asp-action="Login">← Back to Login</a>
            </div>
        </div>

        <!-- RIGHT: Illustration -->
        <div class="forgot-right">
            <img src="~/images/work_safe.jpeg" alt="Safety Illustration" />
            <h3>Secure Account Recovery</h3>
            <p>Your safety system access, restored securely.</p>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
